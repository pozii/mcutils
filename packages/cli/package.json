  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@mcutils/core": "0.1.0",
    "@mcutils/server": "0.1.0",
    "@mcutils/world": "0.1.0",
    "@mcutils/log": "0.1.0"
  }
}
